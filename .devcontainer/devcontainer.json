{
  "name": "Servicios Cloud · Semana 11 · Escalabilidad y elasticidad",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8080],
  "portsAttributes": { "8080": { "label": "ShopLab (balanceador Nginx)" } },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker", "github.vscode-github-actions"]
    }
  }
}
